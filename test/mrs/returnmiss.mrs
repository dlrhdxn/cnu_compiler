// expect: MISSING_RETURN@2
// A function with a return type must return a value on every path.
// An `if` counts only when it has an `else` and both branches return
// (here the last `else if` has no `else`). A `while` never counts.
// The error is reported at the function name (token 2 = ID('sign')).

fn sign(n: i32) -> i32 {
    if n < 0 {
        return -1;
    } else if n > 0 {
        return 1;
    }
    // no return when n == 0
}

fn main() {
    print(sign(3));
}
