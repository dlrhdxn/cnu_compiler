// Test Case 3
fn sum_to_n(n: i32) -> i32 {
    let mut total = 0;
    let mut i = 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn main() {
    let mut count = 5;
    while count > 0 {
        print(count);
        count = count - 1;
    }
    print(sum_to_n(10));
}
