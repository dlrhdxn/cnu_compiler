// Test Case 2
fn classify(n: i32) -> bool {
    if n >= 0 && n <= 100 {
        print(1);
        return true;
    } else {
        print(0);
        return false;
    }
}

fn main() {
    let a = 10;
    let b = 20;
    if a == b || a != b {
        print(a);
    }
    if !(a < b) {
        print(999);
    } else {
        print(-1);
    }
    classify(50);
}
